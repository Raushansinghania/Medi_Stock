PORT=5000
NODE_ENV=development

# ==============================================================================
# DATABASE CONFIGURATION (MySQL 8.0 / Railway MySQL)
# ==============================================================================
# For Local Development:
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=medistock_app
DB_PASSWORD=your_mysql_password_here
DB_NAME=medistock

# For Railway Deployment (Railway provides these automatically, or pass MYSQL_URL):
# MYSQLHOST=
# MYSQLPORT=
# MYSQLUSER=
# MYSQLPASSWORD=
# MYSQLDATABASE=
# MYSQL_URL=mysql://user:password@host:port/database

DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0
# DB_SSL=false

# ==============================================================================
# AUTHENTICATION & SECURITY
# ==============================================================================
JWT_SECRET=medistock_jwt_super_secret_dev_key_change_in_production
JWT_EXPIRES_IN=7d

# ==============================================================================
# CLIENT URL (CORS) - Set to your Vercel frontend URL in production
# Example: CLIENT_URL=https://medistock.vercel.app,http://localhost:5173
# ==============================================================================
CLIENT_URL=http://localhost:5173
